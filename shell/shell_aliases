# Terminal
alias ll='ls -FGlAhp'                       # Preferred 'ls' implementation
alias cd..='cd ../'                         # Go back 1 directory level (for fast typers)
alias ..='cd ../'                           # Go back 1 directory level
alias ~="cd ~"                              # ~:	Go Home
alias c='clear'                             # c:	Clear terminal display

# Git
alias gbc='git checkout -b'                                                             # Create and checkout new branch
alias prune='git branch --merged | grep -v "^[*+]\|^. main" | xargs git branch -d'    # Prune merged branches
alias gdiff='{ git diff --name-only; git diff --cached --name-only; git ls-files --others --exclude-standard; } | sort -u | fzf \
  --preview "git diff --color=always -- {} | grep -q . && git diff --color=always -- {} || git diff --cached --color=always -- {} | grep -q . && git diff --cached --color=always -- {} || bat --color=always {}" \
  --preview-window=right:70% \
  --ansi \
  --multi \
  --header "tab: select  enter: open in code  ctrl-u/d: scroll preview  ctrl-c: quit" \
  --bind "enter:execute(code {+})+abort" \
  --bind "ctrl-d:preview-down,ctrl-u:preview-up"'

# Development
alias nuke='rm -rf ~/Library/Developer/Xcode/DerivedData/ ; echo "Successfully cleared Derived Data ♻️ "'	 # Clean derived data
alias sources='cd ~/Sources'		# Navigate to Sources directory
alias dotfiles='cd ~/Sources/dotfiles' 	# Navigation to dotfiles project
alias be="bundle exec "

# Ghostty
alias ghostty-config='$EDITOR ~/.config/ghostty/config'
alias ghostty-reload='kill -USR1 $(pgrep ghostty)'
