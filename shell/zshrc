# Zsh Options
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS EXTENDED_GLOB INTERACTIVE_COMMENTS

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

# Keybindings (emacs mode)
bindkey -e
self-insert-newline() { LBUFFER+=$'\n' }
zle -N self-insert-newline
bindkey $'\e[13;2u'    self-insert-newline  # Shift+Enter → newline (kitty keyboard protocol)
bindkey $'\e[27;2;13~' self-insert-newline  # Shift+Enter → newline (modifyOtherKeys/xterm)

# PATH
export PATH=/opt/homebrew/bin:$PATH
export PATH="$HOME/.rbenv/bin:$PATH"
export PATH="$HOME/.rbenv/shims:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Completion
if type brew &>/dev/null; then
  FPATH=/opt/homebrew/share/zsh-completions:$FPATH
fi
autoload -Uz compinit
if [[ -n "$HOME/.zcompdump"(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Environment
export EDITOR='vim'
export VISUAL='vim'
export CLICOLOR=1
export GPG_TTY=$(tty)

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"

# Aliases
[[ -f ~/.shell_aliases ]] && source ~/.shell_aliases
alias cc='claude'

